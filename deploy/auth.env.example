# Copy these settings into the server's .env.production.
# Both api-gateway and user-service already read that file.
AUTH_ACCESS_TTL_SECONDS=900
AUTH_SESSION_MAX_SECONDS=28800
AUTH_IDLE_TIMEOUT_SECONDS=1800
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900

# HTTP compatibility for the current IP address. Set true after switching to HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_TRUSTED_ORIGINS=http://14.174.183.56

# API Gateway: set explicit IP/CIDR addresses of your actual reverse proxies.
# Empty means do not trust forwarded headers; users behind a proxy share its rate-limit bucket.
# Never use true, wildcard, /0, or assume a Docker subnet without checking it.
TRUSTED_PROXY_CIDRS=

# Enable once a matching, persistent RSA key pair is provisioned for user-service.
# Do not put real keys in this example or in Git.
AUTH_REQUIRE_PERSISTENT_KEYS=true
# JWT_PRIVATE_KEY=<PKCS8 PEM with escaped newline characters>
# JWT_PUBLIC_KEY=<SPKI PEM with escaped newline characters>
# JWT_KID=<key version identifier>

# Shared auth state: the two backend containers must use the same Redis endpoint/database.
REDIS_URL=redis://redis:6379
REDIS_DB=0
