generator client {
  provider = "prisma-client-js"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model GatewayService {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  url                 String   // e.g., http://user-service:50051 (comma separated if load balanced)
  loadBalanceStrategy String   @default("ROUND_ROBIN") // NONE, ROUND_ROBIN, RANDOM
  useSsl              Boolean  @default(false)
  ignoreTlsVerify     Boolean  @default(true)
  description         String?
  isActive            Boolean  @default(true)
  
  // Advanced Config
  healthCheckPath     String?  @default("/health")
  healthCheckInterval Int?     @default(30000)
  connectTimeout      Int?     @default(5000)
  readTimeout         Int?     @default(30000)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  routes      GatewayRoute[]
}

model GatewayRoute {
  id          Int      @id @default(autoincrement())
  path        String   @unique // e.g., /api/v1/external/users
  stripPath   Boolean  @default(true) // Whether to strip the path before sending to upstream
  serviceId   Int
  service     GatewayService @relation(fields: [serviceId], references: [id])
  methods     String   @default("GET,POST,PUT,DELETE,PATCH") // Comma separated allowed methods
  isActive    Boolean  @default(true)

  // Advanced Config
  rateLimit   Int?     @default(100)
  cacheTtl    Int?     @default(0)
  timeout     Int?     @default(30000)
  corsEnabled Boolean? @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiKey {
  id          Int      @id @default(autoincrement())
  name        String   // Tên tổ chức/bên thứ 3 được cấp
  key         String   @unique
  description String?
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GatewaySetting {
  id                 Int      @id @default(autoincrement())
  globalTimeout      Int      @default(30000)
  enableRateLimiting Boolean  @default(true)
  defaultRateLimit   Int      @default(100)
  enableCors         Boolean  @default(true)
  allowedOrigins     String   @default("*")
  logLevel           String   @default("info")
  updatedAt          DateTime @updatedAt
}
