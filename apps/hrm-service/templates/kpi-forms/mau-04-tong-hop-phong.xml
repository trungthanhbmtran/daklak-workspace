<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  BIỂU MẪU ĐÁNH GIÁ BAN TỔ CHỨC TỈNH ỦY ĐẮK LẮK
  Mẫu số 04: Bảng tổng hợp kết quả đánh giá tập thể phòng & kê khai nhiệm vụ nổi trội, vượt mức
  Căn cứ: Hướng dẫn số 05-HD/TU và Quy định số 01-QĐ/BTCTU
-->
<KpiFormDocument xmlns="http://btctu.daklak.gov.vn/kpi/v1" formCode="MAU_04" schemaVersion="1.0">
  <Header>
    <AgencyName>{{agencyName}}</AgencyName>
    <OrganizationName>{{organizationName}}</OrganizationName>
    <DepartmentName>{{departmentName}}</DepartmentName>
    <DepartmentCode>{{departmentCode}}</DepartmentCode>
    <DocumentTitle>BẢNG TỔNG HỢP KẾT QUẢ ĐÁNH GIÁ, XẾP LOẠI CHẤT LƯỢNG CỦA ĐƠN VỊ</DocumentTitle>
    <EvaluationPeriod>{{periodName}}</EvaluationPeriod>
    <PeriodYear>{{periodYear}}</PeriodYear>
    <PeriodQuarter>{{periodQuarter}}</PeriodQuarter>
  </Header>

  <DepartmentStatistics totalStaff="{{totalStaffCount}}" evaluatedStaff="{{evaluatedStaffCount}}">
    <StaffRankDistribution>
      <ExcellentCount proposed="{{excellentProposedCount}}" maxAllowed="{{maxExcellentAllowed}}" quotaPercent="{{excellentQuotaPercent}}"/>
      <GoodCount>{{goodCount}}</GoodCount>
      <FairCount>{{fairCount}}</FairCount>
      <PoorCount>{{poorCount}}</PoorCount>
    </StaffRankDistribution>
  </DepartmentStatistics>

  <StaffSummaryTable>
    {{#each staff}}
    <StaffRow orderNumber="{{@number}}">
      <EmployeeCode>{{this.employeeCode}}</EmployeeCode>
      <FullName>{{this.fullName}}</FullName>
      <JobTitle>{{this.jobTitle}}</JobTitle>
      <GeneralScore>{{this.generalScore}}</GeneralScore>
      <TaskScore>{{this.taskScore}}</TaskScore>
      <QualityPenaltyTier>{{this.qualityPenaltyTier}}</QualityPenaltyTier>
      <TotalScore>{{this.totalScore}}</TotalScore>
      <ProposedRank>{{this.proposedRank}}</ProposedRank>
      <IsOutstandingBonus>{{this.isOutstandingBonus}}</IsOutstandingBonus>
      <OutstandingTaskNotes>{{this.outstandingTaskNotes}}</OutstandingTaskNotes>
    </StaffRow>
    {{/each}}
  </StaffSummaryTable>

  <OutstandingTasksRegistry>
    {{#each outstandingTasks}}
    <RegistryItem orderNumber="{{@number}}">
      <EmployeeName>{{this.employeeName}}</EmployeeName>
      <TaskTitle>{{this.taskTitle}}</TaskTitle>
      <DomainCode>{{this.domainCode}}</DomainCode>
      <AchievementsSummary>{{this.achievements}}</AchievementsSummary>
      <BonusScoreAdded>{{this.bonusScoreAdded}}</BonusScoreAdded>
    </RegistryItem>
    {{/each}}
  </OutstandingTasksRegistry>

  <DepartmentSignatures>
    <Compiler>
      <Name>{{compilerName}}</Name>
      <Title>Người tổng hợp</Title>
      <Date>{{compileDate}}</Date>
      <DigitalSignature>{{compilerDigitalSignature}}</DigitalSignature>
    </Compiler>
    <DepartmentHead>
      <Name>{{departmentHeadName}}</Name>
      <Title>{{departmentHeadTitle}}</Title>
      <Date>{{departmentHeadDate}}</Date>
      <DigitalSignature>{{departmentHeadDigitalSignature}}</DigitalSignature>
    </DepartmentHead>
  </DepartmentSignatures>
</KpiFormDocument>
