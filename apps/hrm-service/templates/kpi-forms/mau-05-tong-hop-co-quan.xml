<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  BIỂU MẪU ĐÁNH GIÁ BAN TỔ CHỨC TỈNH ỦY ĐẮK LẮK
  Mẫu số 05: Dự thảo quyết định & Bảng tổng hợp xếp loại chất lượng toàn cơ quan
  Căn cứ: Quy định số 348-QĐ/BTCTW, Hướng dẫn số 05-HD/TU, Quy định số 01-QĐ/BTCTU
  Nguyên tắc khống chế: Trần Xuất sắc <= 20% tổng số Hoàn thành tốt trở lên; 
                        Xếp loại Người đứng đầu <= Xếp loại tập thể phòng.
-->
<KpiFormDocument xmlns="http://btctu.daklak.gov.vn/kpi/v1" formCode="MAU_05" schemaVersion="1.0">
  <Header>
    <AgencyName>{{agencyName}}</AgencyName>
    <OrganizationName>{{organizationName}}</OrganizationName>
    <DecisionNumber>{{decisionNumber}}</DecisionNumber>
    <DecisionDate>{{decisionDate}}</DecisionDate>
    <DocumentTitle>QUYẾT ĐỊNH VỀ VIỆC PHÊ DUYỆT KẾT QUẢ ĐÁNH GIÁ, XẾP LOẠI CHẤT LƯỢNG CÁN BỘ, CÔNG CHỨC</DocumentTitle>
    <EvaluationPeriod>{{periodName}}</EvaluationPeriod>
    <PeriodYear>{{periodYear}}</PeriodYear>
    <PeriodQuarter>{{periodQuarter}}</PeriodQuarter>
  </Header>

  <LegalBasis>
    <Item>Căn cứ Quy định số 348-QĐ/BTCTW của Ban Tổ chức Trung ương về tiêu chuẩn, tiêu chí đánh giá cán bộ;</Item>
    <Item>Căn cứ Quy định số 39-QĐ/TU của Ban Thường vụ Tỉnh ủy về phân cấp quản lý cán bộ;</Item>
    <Item>Căn cứ Hướng dẫn số 05-HD/TU của Ban Thường vụ Tỉnh ủy Đắk Lắk;</Item>
    <Item>Căn cứ Quy định số 01-QĐ/BTCTU của Ban Tổ chức Tỉnh ủy Đắk Lắk;</Item>
    <Item>Xét đề nghị của Hội đồng Thi đua - Khen thưởng và Đánh giá cơ quan Ban Tổ chức Tỉnh ủy.</Item>
  </LegalBasis>

  <AgencyStatisticsSummary>
    <TotalOfficers count="{{officers.length}}"/>
    <TotalEvaluated count="{{officers.length}}"/>
    <ExcellentQuotaControl>
      <GoodOrBetterTotal>{{goodOrBetterCount}}</GoodOrBetterTotal>
      <MaxExcellentAllowed20Pct>{{maxExcellentAllowed}}</MaxExcellentAllowed20Pct>
      <ActualExcellentApproved>{{actualExcellentApproved}}</ActualExcellentApproved>
      <QuotaComplianceStatus>{{quotaComplianceStatus}}</QuotaComplianceStatus>
    </ExcellentQuotaControl>
  </AgencyStatisticsSummary>

  <CollectiveRankings>
    {{#each collectives}}
    <CollectiveItem code="{{this.code}}" name="{{this.name}}" rank="{{this.rank}}"/>
    {{/each}}
  </CollectiveRankings>

  <IndividualFinalRankings count="{{officers.length}}">
    <!-- Danh sách xếp loại chính thức toàn cơ quan -->
    {{#each officers}}
    <OfficerRankingItem id="{{@number}}" orderNumber="{{@number}}">
      <EmployeeCode>{{this.employeeCode}}</EmployeeCode>
      <FullName>{{this.fullName}}</FullName>
      <DepartmentName>{{this.departmentName}}</DepartmentName>
      <JobTitle>{{this.jobTitle}}</JobTitle>
      <TotalScore>{{this.totalScore}}</TotalScore>
      <OfficialRank>{{this.officialRank}}</OfficialRank>
      <UnitLeaderCapApplied>{{this.unitLeaderCapApplied}}</UnitLeaderCapApplied>
    </OfficerRankingItem>
    {{/each}}
  </IndividualFinalRankings>

  <DecisionTerms>
    <Article1>{{decisionArticle1}}</Article1>
    <Article2>Kết quả đánh giá, xếp loại là căn cứ để thực hiện công tác thi đua, khen thưởng, quy hoạch, đào tạo, bổ nhiệm và thực hiện chế độ chính sách đối với cán bộ, công chức.</Article2>
    <Article3>Chánh Văn phòng, Trưởng các phòng chuyên môn và các cá nhân có tên tại Điều 1 chịu trách nhiệm thi hành Quyết định này.</Article3>
  </DecisionTerms>

  <PromulgationSignature>
    <SignerPlace>Thành phố Buôn Ma Thuột</SignerPlace>
    <SignerTitle>TRƯỞNG BAN TỔ CHỨC TỈNH ỦY</SignerTitle>
    <SignerName>{{headOfAgencyName}}</SignerName>
    <PromulgatedDate>{{promulgatedDate}}</PromulgatedDate>
    <DigitalSignatureVerification>
      <Status>VERIFIED</Status>
      <CertificateOrg>Ban Cơ yếu Chính phủ - CA Chuyên dùng</CertificateOrg>
      <DigitalSignature>{{agencyHeadDigitalSignature}}</DigitalSignature>
    </DigitalSignatureVerification>
  </PromulgationSignature>
</KpiFormDocument>
