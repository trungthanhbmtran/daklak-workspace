// Nhân viên HRM – departmentId, jobTitleId tham chiếu sang user-service (OrganizationUnit, JobTitle)
model Employee {
  id     Int     @default(autoincrement())
  // Thêm user_id theo chuẩn DDD (Tham chiếu sang user-service)
  userId String? @map("user_id")

  firstname    String    @map("firstname")
  lastname     String    @map("lastname")
  fullName     String    @map("full_name")
  employeeCode String    @map("employee_code")
  email        String?
  phone        String?
  gender       String?   @default("male")
  birthday     DateTime? @db.Date
  identityCard String?   @map("identity_card")

  // Employment information
  employmentType   String? @map("employment_type")
  employmentStatus String  @default("active") @map("employment_status")
  contractInfo     Json?   @map("contract_information")

  address String? @db.LongText
  avatar  String? @db.Text

  // Lưu dưới dạng Projection (Read Model) ID, không lấy tên từ đây
  departmentId       Int?     @map("department_id")
  jobTitleId         Int?     @map("job_title_id")
  civilServantRankId Int?     @map("civil_servant_rank_id")
  partyTitleId       Int?     @map("party_title_id")
  startDate          DateTime @map("start_date") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  isDeleted          Boolean  @default(false) @map("is_deleted")

  // Relations (Đã gỡ bỏ các relation trực tiếp với Task cũ)
  kpiEvaluations   KpiEvaluation[]   @relation("KpiEmployee")
  kpiReviews       KpiEvaluation[]   @relation("KpiReviewer")
  taskParticipants TaskParticipant[] @relation("EmployeeTasks")

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@unique([employeeCode, organizationId])
  @@map("employees")
}

model KpiRuleSet {
  id       Int     @default(autoincrement())
  unitId   String  @map("unit_code") // Mã tổ chức (Từ user-service, ví dụ: 'BTCTU_DAKLAK')
  version  String  @map("version") // Phiên bản công thức (Ví dụ: "v1.2026")
  isActive Boolean @default(true) @map("is_active")

  maxGeneralScore Float @default(30.0) @map("max_general_score")
  maxTaskScore    Float @default(70.0) @map("max_task_score")

  // Các hệ số giới hạn chung
  bonusThresholdPct Float @default(10.0) @map("bonus_threshold_pct") // Mức % vượt KH để tính thưởng
  maxBonusPct       Float @default(120.0) @map("max_bonus_pct") // Khống chế trần thành tố (Ví dụ: <= 120%)

  domainWeights KpiDomainWeight[]
  evaluations   KpiEvaluation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@unique([unitId, version, organizationId])
  @@map("kpi_rule_sets")
}

model KpiDomainWeight {
  id         Int    @default(autoincrement())
  ruleSetId  Int    @map("rule_set_id")
  domainCode String @map("domain_code") // Mã mảng việc (DOM_THAM_DINH, DOM_VAN_THU...)

  volumeWeight   Float @map("volume_weight") // Trọng số Khối lượng (A)
  qualityWeight  Float @map("quality_weight") // Trọng số Chất lượng (B)
  progressWeight Float @map("progress_weight") // Trọng số Tiến độ (C)
  attitudeWeight Float @map("attitude_weight") // Trọng số Thái độ / Lãnh đạo (D)

  ruleSet KpiRuleSet @relation(fields: [ruleSetId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@unique([ruleSetId, domainCode, organizationId])
  @@map("kpi_domain_weights")
}

model KpiPeriod {
  id          Int             @default(autoincrement())
  name        String          @map("name")
  startDate   DateTime        @map("start_date") @db.Date
  endDate     DateTime        @map("end_date") @db.Date
  evaluations KpiEvaluation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@map("kpi_periods")
}

model KpiEvaluation {
  id             Int    @default(autoincrement())
  employeeCode   String @map("employee_code")
  periodId       Int    @map("period_id")
  staffingSlotId Int?   @map("staffing_slot_id") // Vị trí việc làm / Định biên khi được đánh giá

  // Phiên bản luật chấm điểm
  ruleSetId Int? @map("rule_set_id")

  // Quy trình Workflow Mẫu 01-05
  phase  String @default("REGISTRATION") @map("phase") // REGISTRATION, SELF_EVAL, COLLECTIVE_EVAL, FINAL
  status String @default("DRAFT")

  // Điểm tự chấm (Mẫu 02)
  generalScoreSelf Float? @map("general_score_self")
  taskScoreSelf    Float? @map("task_score_self")

  // Điểm Hội đồng / Quyết định (Mẫu 05)
  generalScoreFinal Float? @map("general_score_final")
  taskScoreFinal    Float? @map("task_score_final")
  totalScore        Float? @map("total_score")

  reviewerCode String? @map("reviewer_code")

  employee Employee    @relation("KpiEmployee", fields: [employeeCode, organizationId], references: [employeeCode, organizationId])
  reviewer Employee?   @relation("KpiReviewer", fields: [reviewerCode, organizationId], references: [employeeCode, organizationId])
  period   KpiPeriod   @relation(fields: [periodId, organizationId], references: [id, organizationId])
  ruleSet  KpiRuleSet? @relation(fields: [ruleSetId, organizationId], references: [id, organizationId])

  tasks     KpiEvaluationTask[]
  documents KpiFormDocument[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@map("kpi_evaluations")
}

// Bảng lưu công việc đăng ký và chấm điểm (Hợp nhất dữ liệu Mẫu 01, Mẫu 02, Mẫu 04)
model KpiEvaluationTask {
  id           Int    @default(autoincrement())
  evaluationId Int    @map("evaluation_id")
  taskName     String @map("task_name")
  domainCode   String @map("domain_code")

  // Liên kết hệ thống công việc (Task Management)
  taskId Int?  @map("task_id")
  task   Task? @relation(fields: [taskId, organizationId], references: [id, organizationId])

  // 1. Thành tố Khối lượng (A)
  plannedQty   Float   @default(1.0) @map("planned_qty")
  actualQty    Float?  @map("actual_qty")
  difficultyK  Float   @default(1.0) @map("difficulty_k") // Hệ số độ khó (1.0 - 5.0)
  isUnexpected Boolean @default(false) @map("is_unexpected") // Việc đột xuất (Lãnh đạo giao thêm)

  // 2. Thành tố Chất lượng (B)
  errorSeverity String? @map("error_severity") // Phân mức lỗi: NONE, MINOR (nhẹ), MODERATE (trung bình), SEVERE (nghiêm trọng)
  isOutstanding Boolean @default(false) @map("is_outstanding") // Mẫu 04: Thưởng nhiệm vụ nổi trội (+10%)

  // 3. Thành tố Tiến độ (C)
  deadlineDays Int?    @map("deadline_days")
  actualDays   Int?    @map("actual_days")
  hasExtension Boolean @default(false) @map("has_extension") // Gia hạn hợp lệ duyệt trước 24h

  // 4. Thành tố Thái độ / Lãnh đạo (D)
  attitudeScore Float? @map("attitude_score") // Do Lãnh đạo/Người đánh giá chấm

  // Kết quả tính toán lưu vết
  calculatedVolumePct   Float? @map("calculated_volume_pct")
  calculatedQualityPct  Float? @map("calculated_quality_pct")
  calculatedProgressPct Float? @map("calculated_progress_pct")
  calculatedAttitudePct Float? @map("calculated_attitude_pct")
  finalKpiScore         Float? @map("final_kpi_score")

  evaluation KpiEvaluation @relation(fields: [evaluationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@map("kpi_evaluation_tasks")
}

// Quản lý các biểu mẫu hành chính (Administrative Forms) độc lập với hệ thống tính toán (Metric Engine)
model KpiFormTemplate {
  formCode    String  @map("form_code") // Ví dụ: MAU_01, MAU_02
  name        String  @map("name")
  description String? @db.Text

  // File mẫu XML gốc lưu tại media-service
  templateFileId String? @map("template_file_id")

  documents KpiFormDocument[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([formCode, organizationId])
  @@map("kpi_form_templates")
}

model KpiFormDocument {
  id           Int    @default(autoincrement())
  formCode     String @map("form_code")
  evaluationId Int    @map("evaluation_id")

  // ID của file biểu mẫu (XML/PDF) sau khi điền dữ liệu, lưu tại media-service
  documentFileId String? @map("document_file_id")

  // Dữ liệu bóc tách dạng JSON để truy vấn nhanh (tùy chọn)
  contentJson Json? @map("content_json")

  status        String  @default("DRAFT") @map("status") // DRAFT, SUBMITTED, APPROVED, REJECTED
  submitterCode String? @map("submitter_code")
  signerCode    String? @map("signer_code") // Người ký duyệt

  // Metadata quyết định (Ví dụ cho Mẫu 05)
  decisionNumber String?   @map("decision_number")
  decisionDate   DateTime? @map("decision_date") @db.Date

  template   KpiFormTemplate @relation(fields: [formCode, organizationId], references: [formCode, organizationId])
  evaluation KpiEvaluation   @relation(fields: [evaluationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@map("kpi_form_documents")
}

generator client {
  provider     = "prisma-client-js"
  engineType   = "binary"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model MasterPlan {
  id          Int     @default(autoincrement())
  title       String  @map("title")
  description String? @db.Text
  type        String  @default("SMART_GOAL")

  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  status    String    @default("ACTIVE")

  departmentId  Int?    @map("department_id")
  createdByCode String? @map("created_by_code")

  documentId   String? @map("document_id")
  workflowCode String? @map("workflow_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tasks Task[]

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@map("master_plans")
}

model Task {
  id          Int     @default(autoincrement())
  parentId    Int?    @map("parent_id")
  title       String  @map("title")
  description String? @db.Text

  status       String  @default("PENDING_ACCEPTANCE")
  priority     String  @default("MEDIUM")
  type         String  @default("TASK") @map("type")
  meetingLink  String? @map("meeting_link") @db.Text
  progress     Float   @default(0) @map("progress")
  rejectReason String? @map("reject_reason") @db.Text

  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at")
  isCompleted Boolean   @default(false) @map("is_completed")

  domainId        Int? @map("domain_id")
  monitoredUnitId Int? @map("monitored_unit_id")
  planId          Int? @map("plan_id")

  workflowInstId String? @map("workflow_instance_id")
  conversationId String? @map("conversation_id")
  metadata       Json?   @map("metadata")

  creatorEmployeeCode String?  @map("creator_employee_code")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  isDeleted           Boolean  @default(false) @map("is_deleted")

  plan           MasterPlan?         @relation(fields: [planId, organizationId], references: [id, organizationId])
  kpiEvaluations KpiEvaluationTask[]

  participants TaskParticipant[]
  attachments  TaskAttachment[]
  histories    TaskHistory[]
  steps        TaskStep[]

  ancestors        TaskClosure[]         @relation("TaskClosureDescendant")
  descendants      TaskClosure[]         @relation("TaskClosureAncestor")
  notificationLogs TaskNotificationLog[]

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@index([dueDate])
  @@index([status, dueDate])
  @@index([isCompleted, dueDate])
  @@index([parentId])
  @@index([planId])
  @@index([createdAt])
  @@map("tasks")
}

model TaskStep {
  id           Int       @default(autoincrement())
  taskId       Int       @map("task_id")
  title        String    @map("title")
  status       String    @default("TODO") // TODO, COMPLETED
  order        Int       @default(0)
  assigneeCode String?   @map("assignee_code")
  baseScore    Float     @default(0) @map("base_score")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  isDeleted    Boolean   @default(false) @map("is_deleted")

  task Task @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@index([taskId])
  @@map("task_steps")
}

model TaskAttachment {
  id         Int      @default(autoincrement())
  taskId     Int      @map("task_id")
  documentId String   @map("document_id")
  type       String   @default("REFERENCE")
  createdAt  DateTime @default(now()) @map("created_at")
  isDeleted  Boolean  @default(false) @map("is_deleted")

  task Task @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@index([taskId])
  @@map("task_attachments")
}

enum TaskRole {
  OWNER
  ASSIGNEE
  APPROVER
  COORDINATOR
  FOLLOWER
}

model TaskParticipant {
  taskId                 Int      @map("task_id")
  employeeCode           String   @map("employee_code")
  participantRole        TaskRole @map("participant_role")
  assignedAt             DateTime @default(now()) @map("assigned_at")
  contributionPercentage Float    @default(100.0) @map("contribution_percentage")

  status     String    @default("PENDING_ACCEPTANCE") @map("status")
  reason     String?   @map("reason") @db.Text
  attendedAt DateTime? @map("attended_at")

  task     Task     @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employee Employee @relation("EmployeeTasks", fields: [employeeCode, organizationId], references: [employeeCode, organizationId])

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([taskId, employeeCode, participantRole, organizationId])
  @@map("task_participants")
}

model TaskClosure {
  ancestorId   Int @map("ancestor_id")
  descendantId Int @map("descendant_id")
  depth        Int @map("depth")

  ancestor   Task @relation("TaskClosureAncestor", fields: [ancestorId, organizationId], references: [id, organizationId], onDelete: Cascade)
  descendant Task @relation("TaskClosureDescendant", fields: [descendantId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([ancestorId, descendantId, organizationId])
  @@map("task_closure")
}

model TaskHistory {
  id        Int      @default(autoincrement())
  taskId    Int      @map("task_id")
  action    String   @map("action")
  actorCode String?  @map("actor_code")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@index([taskId])
  @@map("task_histories")
}

model TaskNotificationLog {
  id        Int      @default(autoincrement())
  taskId    Int      @map("task_id")
  type      String   @map("type")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@unique([taskId, type, organizationId])
  @@index([taskId])
  @@map("task_notification_logs")
}

model TaskRankTemplate {
  id                   Int     @default(autoincrement())
  classification       String  @map("classification")
  rank                 String  @map("rank")
  domainCode           String  @default("GENERIC") @map("domain_code")
  taskName             String  @map("task_name")
  defaultUnit          String  @map("default_unit")
  defaultWeight        Float?  @map("default_weight")
  standardDurationDays Float?  @map("standard_duration_days") // Thêm trường thời gian chuẩn
  rankNameVN           String? @map("rank_name_vn")
  legalBasis           String? @map("legal_basis")
  workflowId           String? @map("workflow_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@map("task_rank_templates")
}

model RankQuota {
  id          Int    @default(autoincrement())
  rankCode    String @map("rank_code")
  domainCode  String @default("GENERIC") @map("domain_code")
  taskName    String @map("task_name")
  unit        String @map("unit")
  targetValue Float  @map("target_value")
  weight      Float? @map("weight")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@map("rank_quotas")
}

// =============================================================================
// DISTRIBUTED WORKFLOW INFRASTRUCTURE (Data Plane)
// =============================================================================

// Bảng Outbox lưu trữ Command/Event khi hệ thống Offline hoặc để đảm bảo Transaction
model OutboxEvent {
  id                 String    @default(uuid())
  workflowInstanceId String?   @map("workflow_instance_id")
  processVersion     Int?      @map("process_version")
  nodeId             String?   @map("node_id")
  commandType        String    @map("command_type")
  payload            Json
  status             String    @default("PENDING") // PENDING, SYNCING, PROCESSED, FAILED
  retryCount         Int       @default(0) @map("retry_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  processedAt        DateTime? @map("processed_at")
  errorReason        String?   @map("error_reason") @db.Text

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([id, organizationId])
  @@index([status])
  @@index([workflowInstanceId])
  @@map("outbox_events")
}

// Bảng Inbox chống Duplicate Event (Idempotency) khi mạng chập chờn
model ProcessedCommand {
  commandId          String   @map("command_id")
  workflowInstanceId String   @map("workflow_instance_id")
  processedAt        DateTime @default(now()) @map("processed_at")
  action             String
  status             String   @default("SUCCESS") // SUCCESS, REJECTED

  organizationId String @default("DEFAULT") @map("organization_id")

  @@id([commandId, organizationId])
  @@index([workflowInstanceId])
  @@map("processed_commands")
}
