model User {
  id              Int               @default(autoincrement())
  email           String            
  username        String?           
  fullName        String?           @map("full_name")
  phoneNumber     String?           @map("phone_number")
  avatarUrl       String?           @map("avatar_url")
  cccd            String?           @map("cccd")
  employeeCode    String?           @map("employee_code")
  isActive        Boolean           @default(true) @map("is_active")
  authVersion     Int               @default(0) @map("auth_version")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  UserToUserGroup UserToUserGroup[]
  accounts        Account[]
  credential      Credential?
  refreshTokens   RefreshToken[]
  jobPositions    JobPosition[]
  policies        UserPolicy[]
  userConfigs     UserConfig[]
  aiAssistants    AiAssistant[]

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([id, organizationId])
  @@unique([email, organizationId])
  @@unique([username, organizationId])
  @@map("users")
}

model JobPosition {
  id             Int              @default(autoincrement())
  userId         Int              @map("user_id")
  unitId         Int              @map("unit_id")
  jobTitleId     Int              @map("job_title_id")
  isPrimary      Boolean          @default(false) @map("is_primary")
  isUnitLeader   Boolean          @default(false) @map("is_unit_leader")
  isDeputyLeader Boolean          @default(false) @map("is_deputy_leader")
  startDate      DateTime         @default(now()) @map("start_date")
  endDate        DateTime?        @map("end_date")
  jobTitle       JobTitle         @relation(fields: [jobTitleId, organizationId], references: [id, organizationId])
  unit           OrganizationUnit @relation(fields: [unitId, organizationId], references: [id, organizationId])
  user           User             @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([id, organizationId])
  @@index([jobTitleId], map: "job_positions_job_title_id_fkey")
  @@index([unitId], map: "job_positions_unit_id_fkey")
  @@index([userId], map: "job_positions_user_id_fkey")
  @@map("job_positions")
}

model UserGroup {
  id              Int               @default(autoincrement())
  name            String            
  UserToUserGroup UserToUserGroup[]
  policies        UserGroupPolicy[]

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([id, organizationId])
  @@unique([name, organizationId])
  @@map("user_groups")
}

