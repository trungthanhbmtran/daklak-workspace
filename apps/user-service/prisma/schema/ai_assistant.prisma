model AiAssistant {
  id           String   @default(cuid())
  userId       Int      @map("user_id") // owner of the assistant
  name         String
  description  String?  @db.Text
  systemPrompt String   @map("system_prompt") @db.Text
  isPublic     Boolean  @default(false) @map("is_public")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  knowledgeSources AiKnowledgeSource[]
  tools            AiAssistantTool[]

  user User @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([id, organizationId])
  @@index([userId])
  @@map("ai_assistants")
}
