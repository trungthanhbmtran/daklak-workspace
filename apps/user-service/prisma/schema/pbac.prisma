model Policy {
  id         Int         @default(autoincrement()) @id 
  resourceId Int         @map("resource_id")
  action     String
  effect     String      @default("ALLOW")
  conditions Json?
  resource   Resource    @relation(fields: [resourceId], references: [id])
  users      User[]      @relation("PolicyToUser")
  userGroups UserGroup[] @relation("PolicyToUserGroup")

  organizationId String @default("DEFAULT") @map("organization_id")
  @@index([resourceId], map: "policies_resource_id_fkey")
  @@map("policies")
}

model Resource {
  id          Int      @default(autoincrement()) @id 
  code        String @unique 
  name        String
  serviceCode String?  @map("service_code")
  policies    Policy[]

  organizationId String @default("DEFAULT") @map("organization_id")
  @@map("resources")
}


