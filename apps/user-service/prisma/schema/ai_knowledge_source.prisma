model AiKnowledgeSource {
  id             String      @id @default(cuid())
  assistantId    String      @map("assistant_id")
  type           String
  title          String
  content        String?     @db.LongText
  metadata       String?     @db.Text
  qdrantId       String?     @map("qdrant_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  organizationId String      @default("DEFAULT") @map("organization_id")
  assistant      AiAssistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@index([assistantId])
  @@map("ai_knowledge_sources")
}
