model Credential {
  id           String   @default(cuid()) @id 
  userId       Int      @map("user_id") @unique 
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")
  @@map("auth_credentials")
}

model Account {
  id                String  @default(cuid()) @id 
  userId            Int     @map("user_id") @unique 
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")
  @@unique([provider, providerAccountId, organizationId])
  @@index([userId], map: "auth_accounts_user_id_fkey")
  @@map("auth_accounts")
}

model RefreshToken {
  id              String   @default(cuid()) @id 
  token           String   @db.VarChar(512) @unique 
  userId          Int      @map("user_id") @unique 
  deviceInfo      String?  @map("device_info")
  ipAddress       String?  @map("ip_address")
  isRevoked       Boolean  @default(false) @map("is_revoked")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  replacedByToken String?  @map("replaced_by_token")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")
  @@index([userId])
  @@map("auth_refresh_tokens")
}
