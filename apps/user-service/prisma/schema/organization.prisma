model OrganizationUnit {
  id            Int                    @default(autoincrement())
  code          String                 
  name          String
  shortName     String?                @map("short_name")
  typeId        Int                    @map("type_id")
  parentId      Int?                   @map("parent_id")
  hierarchyPath String?                @map("hierarchy_path")
  address       String?
  phoneNumber   String?                @map("phone_number")
  email         String?
  website       String?
  taxCode       String?                @map("tax_code")
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  jobPositions  JobPosition[]
  staffingPlans OrganizationStaffing[]
  unitDomains   UnitDomain[]

  parent                   OrganizationUnit?           @relation("OrgHierarchy", fields: [parentId, organizationId], references: [id, organizationId])
  children                 OrganizationUnit[]          @relation("OrgHierarchy")
  type                     UnitType                    @relation(fields: [typeId, organizationId], references: [id, organizationId])
  monitoredByStaffingSlots StaffingSlotMonitoredUnit[]

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([id, organizationId])
  @@unique([code, organizationId])
  @@index([typeId])
  @@index([parentId])
  @@index([hierarchyPath])
  @@map("organization_units")
}

model UnitDomain {
  unitId   Int              @map("unit_id")
  domainId Int              @map("domain_id")
  domain   Category         @relation(fields: [domainId, organizationId], references: [id, organizationId], onDelete: Cascade)
  unit     OrganizationUnit @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([unitId, domainId, organizationId])
  @@index([domainId], map: "organization_unit_domains_domain_id_fkey")
  @@map("organization_unit_domains")
}

model JobTitle {
  id                      Int                    @default(autoincrement())
  code                    String                 
  name                    String
  description             String?
  category                String?
  rank                    Int                    @default(0)
  authorityLevel          String?                @map("authority_level")
  reportsToJobTitleId     Int?                   @map("reports_to_position_id")
  type                    String?                @default("GOVERNMENT")
  jobPositions            JobPosition[]
  reportsTo               JobTitle?              @relation("JobTitleReportsTo", fields: [reportsToJobTitleId, organizationId], references: [id, organizationId])
  directReports           JobTitle[]             @relation("JobTitleReportsTo")
  staffingPlans           OrganizationStaffing[]
  applicableUnitTemplates UnitTypeJobTemplate[]
  categoryId              Int?                   @map("category_id")
  group                   Category?              @relation(fields: [categoryId, organizationId], references: [id, organizationId])

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([id, organizationId])
  @@unique([code, organizationId])
  @@index([reportsToJobTitleId])
  @@map("job_titles")
}

model OrganizationStaffing {
  id           Int              @default(autoincrement())
  unitId       Int              @map("unit_id")
  jobTitleId   Int              @map("job_title_id")
  quantity     Int              @default(1)
  currentCount Int              @default(0) @map("current_count")
  description  String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  jobTitle     JobTitle         @relation(fields: [jobTitleId, organizationId], references: [id, organizationId])
  unit         OrganizationUnit @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Cascade)
  slots        StaffingSlot[]

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([id, organizationId])
  @@unique([unitId, jobTitleId, organizationId])
  @@index([jobTitleId], map: "org_staffing_job_title_id_fkey")
  @@map("org_staffing")
}

model StaffingSlot {
  id                   Int                          @default(autoincrement())
  staffingId           Int                          @map("staffing_id")
  slotOrder            Int                          @map("slot_order")
  description          String?                      @map("description")
  assignedEmployeeCode String?                      @map("assigned_employee_code")
  monitoredUnits       StaffingSlotMonitoredUnit[]
  geographicAreas      StaffingSlotGeographicArea[]
  domains              StaffingSlotDomain[]
  staffing             OrganizationStaffing         @relation(fields: [staffingId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([id, organizationId])
  @@unique([staffingId, slotOrder, organizationId])
  @@index([staffingId])
  @@map("staffing_slots")
}

model StaffingSlotMonitoredUnit {
  slotId Int              @map("slot_id")
  unitId Int              @map("unit_id")
  slot   StaffingSlot     @relation(fields: [slotId, organizationId], references: [id, organizationId], onDelete: Cascade)
  unit   OrganizationUnit @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([slotId, unitId, organizationId])
  @@index([unitId], map: "staffing_slot_monitored_units_unit_id_fkey")
  @@map("staffing_slot_monitored_units")
}

model StaffingSlotGeographicArea {
  slotId           Int          @map("slot_id")
  geographicAreaId Int          @map("geographic_area_id")
  slot             StaffingSlot @relation(fields: [slotId, organizationId], references: [id, organizationId], onDelete: Cascade)
  geographicArea   Category     @relation(fields: [geographicAreaId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([slotId, geographicAreaId, organizationId])
  @@index([geographicAreaId], map: "staffing_slot_geographic_areas_geographic_area_id_fkey")
  @@map("staffing_slot_geographic_areas")
}

model StaffingSlotDomain {
  slotId   Int          @map("slot_id")
  domainId Int          @map("domain_id")
  slot     StaffingSlot @relation(fields: [slotId, organizationId], references: [id, organizationId], onDelete: Cascade)
  domain   Category     @relation(fields: [domainId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([slotId, domainId, organizationId])
  @@index([domainId], map: "staffing_slot_domains_domain_id_fkey")
  @@map("staffing_slot_domains")
}
