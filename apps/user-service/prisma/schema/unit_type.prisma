model UnitType {
  id                Int                   @default(autoincrement())
  code              String                
  name              String
  description       String?
  level             Int                   @default(1)
  isActive          Boolean               @default(true) @map("is_active")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  organizationUnits OrganizationUnit[]
  jobTemplates      UnitTypeJobTemplate[]

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([id, organizationId])
  @@unique([code, organizationId])
  @@map("unit_types")
}

model UnitTypeJobTemplate {
  unitTypeId Int      @map("unit_type_id")
  jobTitleId Int      @map("job_title_id")
  jobTitle   JobTitle @relation(fields: [jobTitleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  unitType   UnitType @relation(fields: [unitTypeId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @default("DEFAULT") @map("organization_id")
  @@id([unitTypeId, jobTitleId, organizationId])
  @@index([jobTitleId], map: "unit_type_job_templates_job_title_id_fkey")
  @@map("unit_type_job_templates")
}
