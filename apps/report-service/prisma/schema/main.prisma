// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client-js"
  engineType   = "binary"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model ReportTemplate {
  id          Int                @id @default(autoincrement())
  title       String             @db.VarChar(255)
  description String?            @db.Text
  layout      Json? // Lưu trữ lưới (Grid layout) của các Widget
  widgets     ReportWidget[]
  assignments ReportAssignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ReportWidget {
  id             Int            @id @default(autoincrement())
  templateId     Int
  title          String         @db.VarChar(255)
  chartType      String         @db.VarChar(50) // "BAR", "PIE", "LINE", "TABLE"
  dataSourceCode String         @db.VarChar(100) // "HRM_TASK_STATS", "DOC_STATS"
  xAxisKey       String         @db.VarChar(100)
  yAxisKey       String         @db.VarChar(100)
  config         Json? // Cấu hình màu sắc, bộ lọc...
  template       ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model ReportAssignment {
  id           Int      @id @default(autoincrement())
  templateId   Int
  assigneeType String   @db.VarChar(50) // "USER", "UNIT"
  assigneeId   String   @db.VarChar(50)
  permissions  String   @default("VIEW") @db.VarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  template ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, assigneeType, assigneeId])
}

// Bảng dùng để lưu thống kê dạng Read-Model (CQRS) do RabbitMQ đẩy vào
model StatisticsSnapshot {
  id             Int      @id @default(autoincrement())
  dataSourceCode String   @db.VarChar(100)
  data           Json // Lưu dữ liệu thống kê
  recordedAt     DateTime @default(now())
}

model ReportDefinition {
  id             Int     @id @default(autoincrement())
  code           String  @unique @db.VarChar(100)
  name           String  @db.VarChar(255)
  description    String? @db.Text
  version        Int     @default(1)
  organizationId Int? // Phạm vi tổ chức của báo cáo (PBAC)
  ownerId        Int? // Người tạo/sở hữu báo cáo

  // Lưu cấu hình: sources, join graph, fields, filters, groups, sorts
  configuration Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs ReportRun[]
}

model ReportRun {
  id                 Int    @id @default(autoincrement())
  reportDefinitionId Int
  definitionVersion  Int // Chụp lại version của cấu hình lúc chạy
  status             String @db.VarChar(50) // "QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "PARTIAL"

  organizationId Int? // Scope tổ chức lúc chạy
  executorId     Int? // ID người chạy

  rowCount       Int?
  checksum       String?   @db.VarChar(255)
  errors         Json? // Các lỗi hoặc metadata của nguồn bị lỗi (redacted)
  retentionUntil DateTime? // Thời hạn lưu trữ snapshot

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  definition ReportDefinition  @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  snapshots  DatasetSnapshot[]

  @@index([organizationId])
  @@index([status])
}

model DatasetSnapshot {
  id         Int      @id @default(autoincrement())
  runId      Int
  chunkIndex Int      @default(0) // Dùng khi lưu dữ liệu lớn chia thành nhiều phần
  schema     Json? // Cấu trúc trả về (metadata)
  data       Json // Dữ liệu dòng (rows)
  recordedAt DateTime @default(now())

  run ReportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, chunkIndex])
}

model ReportDataSource {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(255)
  upstream  String   @db.VarChar(100)
  path      String   @db.VarChar(255)
  fields    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
