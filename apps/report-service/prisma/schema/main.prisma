// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model ReportTemplate {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(255)
  description String?        @db.Text
  layout      Json?          // Lưu trữ lưới (Grid layout) của các Widget
  widgets     ReportWidget[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ReportWidget {
  id             Int            @id @default(autoincrement())
  templateId     Int
  title          String         @db.VarChar(255)
  chartType      String         @db.VarChar(50) // "BAR", "PIE", "LINE", "TABLE"
  dataSourceCode String         @db.VarChar(100) // "HRM_TASK_STATS", "DOC_STATS"
  xAxisKey       String         @db.VarChar(100)
  yAxisKey       String         @db.VarChar(100)
  config         Json?          // Cấu hình màu sắc, bộ lọc...
  template       ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// Bảng dùng để lưu thống kê dạng Read-Model (CQRS) do RabbitMQ đẩy vào
model StatisticsSnapshot {
  id             Int      @id @default(autoincrement())
  dataSourceCode String   @db.VarChar(100)
  data           Json     // Lưu dữ liệu thống kê
  recordedAt     DateTime @default(now())
}
